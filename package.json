{
  "name": "consolx",
  "private": true,
  "description": "A customizable terminal that brings several shells together in one window.",
  "license": "GPL-3.0-only",
  "author": "Pierre Rué",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pierrot-leFouduBus/ConsolX.git"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @consolx/desktop",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
